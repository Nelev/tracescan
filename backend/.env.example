# Copy to .env and adjust. Load with: uv run --env-file .env uvicorn main:app --reload
# Use a role separate from the read-only trace role. The same database holds the graph checkpoints
# and the users, runs and reviews tables: create those with `uv run --env-file .env alembic upgrade head`.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/tracescan
# Where the trace server reads spans and scores from; the app fails at startup without it. The
# same database as DATABASE_URL. Should be a role that can only SELECT from spans and scores;
# the session is read-only either way.
TRACE_DATABASE_URL=postgresql://reader:password@127.0.0.1:5432/tracescan
# The diagnoser reaches its model through OpenRouter; the app fails at startup without a key.
# Put the real key only in .env, never in this tracked file.
OPENROUTER_API_KEY=your-openrouter-key
# Clerk: every route but /health and the trace collector (which takes COLLECTOR_TOKEN_MEDAS) needs a Clerk session token, and the app
# fails at startup without the secret key. The same key as the frontend's .env.local (use the
# TraceScan Clerk application's, not Medas's). Put the real key only in .env.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
# The trace collector's token for each allowed app, one variable per app (COLLECTOR_TOKEN_<APP>);
# the app fails at startup without it. Each is a secret of at least 32 characters, made with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Medas sends its own with OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer%20<token>.
COLLECTOR_TOKEN_MEDAS=replace-with-a-random-secret-of-32-chars-or-more
# Optional but recommended: the JWT public key (Clerk dashboard: API keys -> JWT public key, PEM),
# so tokens are verified without a call to Clerk. Without it the key is fetched and cached.
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."
# Optional: the origins a token may be issued for, as a JSON list. Default: the UI on 3010 and 3000.
# CLERK_AUTHORIZED_PARTIES=["http://localhost:3010", "http://localhost:3000"]
# Optional: an OpenRouter model slug. The default is in agent/const.py.
# DIAGNOSER_MODEL=anthropic/claude-sonnet-5-5
# Optional, on by default: approved proposals are written to out/ as local files and nothing else.
# Off opens a GitHub issue per approved proposal and needs both GITHUB_* settings below.
# DRY_RUN=true
# The repo issues go to when DRY_RUN is off: owner/name, and it must be private (the issue text is
# the diagnoser's prose). The token is fine-grained, with Issues read/write on that repo only.
# Put the real token only in .env.
# GITHUB_REPO=owner/triage-test
# GITHUB_TOKEN=github_pat_your-token
# Optional: the small model that writes the UI spec of each streamed message. Default anthropic/claude-haiku-5.5.
# UI_SPEC_MODEL=anthropic/claude-haiku-5.5
