# Copy to .env and adjust. Load with: uv run --env-file .env uvicorn main:app --reload
# Use a role separate from the read-only trace role. The same database holds the graph checkpoints
# and the users, runs and reviews tables: create those with `uv run --env-file .env alembic upgrade head`.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/tracescan
# Where the trace server reads spans and scores from; the app fails at startup without it. The
# same database as DATABASE_URL. Should be a role that can only SELECT from spans and scores;
# the session is read-only either way.
TRACE_DATABASE_URL=postgresql://reader:password@127.0.0.1:5432/tracescan
# The diagnoser reaches its model through OpenRouter; the app fails at startup without a key.
# Put the real key only in .env, never in this tracked file.
OPENROUTER_API_KEY=your-openrouter-key
# Optional: an OpenRouter model slug. The default is in agent/const.py.
# DIAGNOSER_MODEL=anthropic/claude-sonnet-5-5
# Optional, on by default: approved proposals are written to out/ as local files and nothing else.
# Off is refused at startup until the real writers (GitHub, eval dataset) exist.
# DRY_RUN=true
# Optional: the small model that writes the UI spec of each streamed message. Default anthropic/claude-haiku-5.5.
# UI_SPEC_MODEL=anthropic/claude-haiku-5.5
