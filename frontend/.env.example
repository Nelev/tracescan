# Copy to .env.local. The TraceScan Clerk application's keys (Clerk dashboard -> API keys), the
# same secret key as backend/.env. Without them `next dev` runs in Clerk's keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key
# Optional: where the /api rewrite sends calls. Default http://localhost:8000.
# BACKEND_URL=http://localhost:8010
